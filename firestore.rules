rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isApprovedUser() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    // Supports legacy user docs where document id != auth uid
    function isSelfUserDoc(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid)
      );
    }

    function isAdmin() {
      return isApprovedUser() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOrganizer() {
      return isApprovedUser() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function activityCreationOpenToAll() {
      return exists(/databases/$(database)/documents/app_settings/permissions) &&
             get(/databases/$(database)/documents/app_settings/permissions).data.activityCreationOpenToAll == true;
    }

    // Users collection
    match /users/{userId} {
      // Approved users can browse users; each user can always read their own doc
      allow read: if isApprovedUser() || isSelfUserDoc(userId);

      // New users may only create their own auth-linked doc
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    request.resource.data.authUid == request.auth.uid;

      // Self updates are allowed except sensitive fields; admin can update anything
      allow update: if isAdmin() || (
                      isSelfUserDoc(userId) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'role',
                        'approvalStatus',
                        'approvedBy',
                        'approvedAt',
                        'rejectionReason',
                        'authUid'
                      ])
                    );
      allow delete: if isAdmin() || isSelfUserDoc(userId);
    }

    // Pending clowns - only admins can read, anyone can create (registration); user can delete own
    match /pending_clowns/{clownId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                    request.resource.data.authUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
    }

    // Activities - role-based visibility and approval workflow
    match /activities/{activityId} {
      // Read: Approved users see approved activities, organizers/admins see all
      allow read: if isApprovedUser() && (
        resource.data.approvalStatus == 'approved' ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin() ||
        isOrganizer()
      );
      
      // Create: Organizers/admins always; optionally all approved users if admin enabled it
      allow create: if isOrganizer() || (isApprovedUser() && activityCreationOpenToAll());
      
      // Update: Organizers can update their own, admins can update any
      allow update: if (isOrganizer() && resource.data.organizerId == request.auth.uid) ||
                       isAdmin() ||
                       // Allow participants/likes updates for approved users
                       (isApprovedUser() &&
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasAll(['participants', 'likes'])));
      
      // Delete: Organizers can delete their own, admins can delete any
      allow delete: if (isOrganizer() && resource.data.organizerId == request.auth.uid) ||
                       isAdmin();
    }

    // Availabilities - users can manage their own
    match /availabilities/{userId} {
      allow read: if isApprovedUser();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Tutorials - all approved users can read, admins can write
    match /tutorials/{tutorialId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // Comments - approved users can read and create, users can delete their own, admins can delete any
    match /comments/{commentId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow delete: if isApprovedUser() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false; // Comments cannot be edited, only deleted
    }

    // Notifications - users can read their own, system can create
    match /notifications/{notificationId} {
      allow read: if isApprovedUser() && resource.data.userId == request.auth.uid;
      allow create: if isApprovedUser(); // Allow approved users to create notifications (for other users)
      allow update: if isApprovedUser() && resource.data.userId == request.auth.uid; // Users can mark their own as read
      allow delete: if isApprovedUser() && resource.data.userId == request.auth.uid; // Users can delete their own
    }

    // Password reset requests - available from the login screen before authentication
    match /password_reset_requests/{requestId} {
      allow create: if request.resource.data.phoneOrEmail is string &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.createdAt is string;
      allow read, update, delete: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
