{
  "expo": {
    "name": "שמחת הלב",
    "slug": "happyHart",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "happyheart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "17",
      "jsEngine": "jsc",
      "newArchEnabled": false,
      "bundleIdentifier": "com.happyheart.app",
      "googleServicesFile": "./GoogleService-Info-14.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "האפליקציה משתמשת בגלריה כדי לאפשר לך להעלות תמונת פרופיל ולצרף תמונות לפעילויות בתוך האפליקציה.",
        "NSCameraUsageDescription": "האפליקציה משתמשת במצלמה כדי לאפשר לך לצלם תמונת פרופיל או תמונות לפעילויות בתוך האפליקציה."
      }
    },
    "android": {
      "package": "com.happyhart.app",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "updates": {
      "url": "https://u.expo.dev/eeb4b519-a71e-4542-ba20-6b33c3e1600f",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER",
      "requestHeaders": {},
      "enabled": false
    },
    "runtimeVersion": "3.1.1",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeb4b519-a71e-4542-ba20-6b33c3e1600f"
      }
    },
    "owner": "orel_895"
  }
}
